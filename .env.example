# Model: DeepFilterNet | DeepFilterNet2 | DeepFilterNet3 (newest, default).
MODEL_NAME=DeepFilterNet3

# Device is auto-detected (CUDA if visible, else CPU).
# Uncomment to force CPU on a GPU machine:
# CUDA_VISIBLE_DEVICES=

# Slightly over-attenuates very noisy sections. true|false.
POST_FILTER=false

# Reject uploads larger than this (bytes). Default 50 MB.
MAX_UPLOAD_BYTES=52428800

# Comma-separated CORS origins, or * for all.
CORS_ORIGINS=*
