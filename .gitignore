# Virtual environments (dfn-env is ~4.6 GB — never commit)
dfn-env/
venv/
.venv/
env/

# Secrets & local configuration (.env.example stays tracked)
.env
.env.*
!.env.example

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Packaging / build artifacts
build/
dist/
*.egg-info/

# Model weights & checkpoints (DeepFilterNet caches outside the repo, but just in case)
*.safetensors
*.bin
*.ckpt
*.onnx
*.tar.gz

# Audio samples / temporary media (denoised outputs, test clips)
*.wav
*.mp3
*.flac
*.ogg
*.m4a

# Logs & OS/editor noise
*.log
.DS_Store
.idea/
.vscode/
